        <mxCell id="kkuTZYCbr9MnTPad1QXG-35" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#495057;html=1;" value="&lt;p&gt;欧拉公式被誉为“上帝公式”：&lt;br&gt;它将数学中最重要的几个常数（$e$, $\pi$, $i$, $1$, $0$）及基本运算符号（加法、乘法、乘方）完美地结合在同一个式子中。&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="400" x="1027" y="767" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n  subgraph Pythagorean [\&quot;同角三角函数的基本关系\&quot;]\n    direction LR\n    A[\&quot;sin²α + cos²α = 1\&quot;]\n    B[\&quot;tanα = sinα / cosα\&quot;]\n    C[\&quot;1 + tan²α = sec²α\&quot;]\n  end\n\n  subgraph DoubleAngle [\&quot;二倍角公式\&quot;]\n    direction LR\n    D[\&quot;sin(2α) = 2sinαcosα\&quot;]\n    E[\&quot;cos(2α) = cos²α - sin²α\&quot;]\n    F[\&quot;tan(2α) = 2tanα / (1 - tan²α)\&quot;]\n  end\n\n  subgraph SumDiff [\&quot;和差化积 / 积化和差\&quot;]\n    direction LR\n    G[\&quot;sin(α ± β) = sinαcosβ ± cosαsinβ\&quot;]\n    H[\&quot;cos(α ± β) = cosαcosβ ∓ sinαsinβ\&quot;]\n  end\n\n  Pythagorean --&gt; DoubleAngle\n  DoubleAngle --&gt; SumDiff\n\n  style Pythagorean fill:#e1f5fe,stroke:#01579b,stroke-width:2px\n  style DoubleAngle fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px\n  style SumDiff fill:#fff3e0,stroke:#e65100,stroke-width:2px&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="kkuTZYCbr9MnTPad1QXG-41">
